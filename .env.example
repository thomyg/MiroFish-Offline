# =============================================================
# MiroFish-Offline Configuration
# =============================================================
# Default config: MiniMax (LLM + embeddings).
#
# All LLM and embedding traffic flows through the provider layer
# (app/providers/). Switch providers via *_PROVIDER below; the rest
# of the app stays provider-agnostic.
#
# See docs/provider-config.md for full per-provider examples and
# alternative setups (Ollama local, Azure OpenAI, hosted OpenAI).
# =============================================================

# ===== LLM provider — MiniMax (Anthropic-style API) =====
LLM_PROVIDER=anthropic_style
LLM_API_KEY=your-minimax-api-key-here
LLM_BASE_URL=https://api.minimax.io/v1
LLM_MODEL_NAME=MiniMax-M2.7
LLM_ANTHROPIC_VERSION=2023-06-01

# Defaults applied when callers don't override
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# ===== Embedding provider — MiniMax (OpenAI-compatible shape) =====
# NOTE: Untested as of this commit. MiniMax embeddings historically used
# a non-OpenAI shape (texts/vectors instead of input/data + a 'type'
# field). If the first request fails with a 4xx or a parse error, either:
#   - fall back to Ollama embeddings (uncomment block below), or
#   - open an issue to add a dedicated `minimax` embedding provider.
EMBEDDING_PROVIDER=openai_compatible
EMBEDDING_API_KEY=your-minimax-api-key-here
EMBEDDING_BASE_URL=https://api.minimax.io/v1
EMBEDDING_MODEL_NAME=embo-01
EMBEDDING_DIMENSIONS=1536

# ----- Fallback: Ollama embeddings (fully local, no key) -----
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL_NAME=nomic-embed-text
# EMBEDDING_DIMENSIONS=768
# EMBEDDING_API_KEY=

# ===== Neo4j =====
# For Docker: use service name "neo4j" instead of "localhost"
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=mirofish

# ===== OASIS / CAMEL-AI =====
# CAMEL-AI reads OPENAI_API_KEY and OPENAI_API_BASE_URL directly — it does
# not flow through MiroFish's provider layer. OASIS only speaks the OpenAI
# Chat-Completions schema, so it CANNOT use MiniMax/Anthropic-style here.
# For the OASIS simulation step, point this at a local Ollama:
#   ollama serve && ollama pull qwen2.5:14b
OPENAI_API_KEY=ollama
OPENAI_API_BASE_URL=http://localhost:11434/v1

# ===== Docker-mode overrides =====
# Uncomment when running ALL services inside Docker (containers reach each
# other by service name).
# NEO4J_URI=bolt://neo4j:7687
# OPENAI_API_BASE_URL=http://ollama:11434/v1

# =============================================================
# Alternative configurations (uncomment one full block to switch)
# =============================================================

# --- Fully local Ollama (LLM + embeddings, no cloud) ---
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL_NAME=qwen2.5:32b
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_BASE_URL=http://localhost:11434
# EMBEDDING_MODEL_NAME=nomic-embed-text
# EMBEDDING_DIMENSIONS=768

# --- Azure OpenAI (LLM + embeddings) ---
# LLM_PROVIDER=azure_openai
# LLM_API_KEY=...
# LLM_BASE_URL=https://my-resource.openai.azure.com
# LLM_DEPLOYMENT_NAME=gpt-4.1
# LLM_API_VERSION=2024-02-01
# LLM_MODEL_NAME=gpt-4.1
# EMBEDDING_PROVIDER=azure_openai
# EMBEDDING_API_KEY=...
# EMBEDDING_BASE_URL=https://my-resource.openai.azure.com
# EMBEDDING_DEPLOYMENT_NAME=text-embedding-3-small
# EMBEDDING_API_VERSION=2024-02-01
# EMBEDDING_MODEL_NAME=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# --- Hosted OpenAI ---
# LLM_PROVIDER=openai_compatible
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_NAME=gpt-4o-mini
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL_NAME=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
